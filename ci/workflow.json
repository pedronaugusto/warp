{
  "land": true,
  "attest": true,
  "release": true,
  "compile_step": "check",
  "targets": [
    "x86_64-linux-gnu",
    "aarch64-linux-gnu",
    "x86_64-linux-musl",
    "x86_64-windows-gnu",
    "aarch64-windows-gnu",
    "x86_64-macos",
    "aarch64-macos",
    "x86_64-freebsd",
    "powerpc64-linux-musl"
  ],
  "compile_once": true,
  "hardened": true,
  "shards": {"riscv64": 4},
  "jobs": [
    {
      "name": "sizes",
      "step": "check-sizes",
      "tiers": ["fast", "merge", "release"],
      "setup": false,
      "timeout": 30
    }
  ]
}
